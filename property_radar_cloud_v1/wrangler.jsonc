{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "property-radar",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "property-radar-db",
      "database_id": "e51ddfdf-236a-4cf4-8e3e-6ee70f4e7019"
    }
  ],
  "vars": {
    "GITHUB_REPO": "greminxd/Property_Radar_Cloud_v1.0.0",
    "SESSION_DAYS": "30"
  }
}
